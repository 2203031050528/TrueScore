# Copy to backend/.env for local development. Never commit real values.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://localhost:5432/truescore
REDIS_URL=redis://localhost:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of Django whose X-Forwarded-For entries are trusted
# (local dev via Next.js rewrite = 1, Vercel -> Render = 2)
TRUSTED_PROXY_COUNT=1
INTERNAL_CRON_SECRET=dev-internal-secret
# Leave R2 empty to use the local signed-storage fallback (files in backend/media)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=
VIDEO_URL_TTL=300
SENTRY_DSN=
